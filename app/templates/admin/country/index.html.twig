{% extends 'base.html.twig' %}

{% block title %}Управление странами{% endblock %}

{% block admin_content %}
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1">Управление странами</h1>
                    <p class="mb-0 opacity-75">Все страны</p>
                </div>
            </div>
        </div>
    </div>
    <div class="position-fixed bottom-0 end-0 m-4" style="z-index: 1000;">
        <div class="card shadow-sm" style="width: 300px;">
            <div class="card-header bg-primary text-white py-2">
                <h6 class="mb-0">➕ Добавить страну</h6>
            </div>
            <div class="card-body p-3">
                {{ form_start(createForm, {
                    'action': path('admin_countries_store'),
                    'attr': {
                        'class': 'country-form',
                        'data-turbo': 'false'
                    }

                }) }}
                <div class="mb-2">
                    {{ form_label(createForm.name, 'Название страны', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.name, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите название'
                        }
                    }) }}
                    {{ form_errors(createForm.name) }}
                </div>
                <button type="submit" class="btn btn-success btn-sm w-100">
                    ➕ Добавить
                </button>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>

    <div class="container-fluid">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th style="width: 5%; min-width: 10px;">ID</th>
                    <th style="width: 15%; min-width: 20px;">name</th>
                    <th style="width: 15%; min-width: 20px;">Состояние</th>
                    <th style="width: 20%; min-width: 50px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for country in countries %}
                    <tr>
                        <td><strong>#{{ country.id }}</strong></td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ country.name }}
                            </div>
                        </td>
                        <td>
                            {% if country.isDeleted %}
                                <span class="badge bg-success">
                                    ❌ Удален
                                </span>
                            {% else %}
                                <span class="badge bg-success">
                                    ✅ Дейсвует
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if country.isDeleted == null %}
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('admin_countries_edit', { 'id': country.id }) }}"
                                       class="btn btn-outline-primary" title="Редактировать">
                                        ✏️
                                    </a>
                                    <form method="post"
                                          action="{{ path('admin_countries_delete', { 'id': country.id }) }}"
                                          style="display: inline;"
                                          onsubmit="return confirm('Вы уверены, что хотите удалить?')"
                                          data-turbo="false">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete' ~ country.id) }}">
                                        <button class="btn btn-outline-danger" title="Удалить">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-users"></i>
                            <h5>Страны не найдены</h5>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if countries.getPageCount() > 1 %}
            <div class="border-top pt-3 mt-4">
                <div class="d-flex justify-content-between align-items-center pagination-container">
                    <div class="text-muted">
                        Страница: <strong>{{ countries.getCurrentPageNumber }}</strong> из
                        <strong>{{ countries.getPageCount() }}</strong>
                    </div>

                    <div>
                        {{ knp_pagination_render(
                            countries,
                            '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig',
                            {},
                            {'css_container_class': 'pagination pagination-sm mb-0'}
                        ) }}
                    </div>

                    <div class="text-muted">
                        Всего: <strong>{{ countries.getTotalItemCount }}</strong> записей
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
{% extends 'admin/base.html.twig' %}

{% block title %}Создание сотрудника{% endblock %}

{% block admin_content %}
    <div>
        <div>
            <div class="card-body">
                {{ form_start(createForm, {
                    'action': path('admin_employees_store'),
                    'attr': {
                        'class': 'country-form',
                        'data-turbo': 'false'
                    }

                }) }}
                <div class="mb-2">
                    {{ form_label(createForm.name, 'Имя', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.name, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите название'
                        }
                    }) }}
                    {{ form_errors(createForm.name) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.surname, 'Фамилия', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.surname, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите фамилию'
                        }
                    }) }}
                    {{ form_errors(createForm.surname) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.phone, 'Телефон', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.phone, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите телефон'
                        }
                    }) }}
                    {{ form_errors(createForm.phone) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.position, 'Должность', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.position, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите должность'
                        }
                    }) }}
                    {{ form_errors(createForm.position) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.email, 'Почта', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.email, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите почту'
                        }
                    }) }}
                    {{ form_errors(createForm.email) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.shop, 'Магазин', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.shop, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                        }
                    }) }}
                    {{ form_errors(createForm.shop) }}
                </div>
                <button type="submit" class="btn btn-success btn-sm w-100">
                    ➕ Создать
                </button>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>

{% endblock %}
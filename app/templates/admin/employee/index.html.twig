{% extends 'admin/base.html.twig' %}

{% block title %}Управление сотрдуниками магазинов{% endblock %}

{% block admin_content %}
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1">Управление сотрдуниками магазинов</h1>
                    <p class="mb-0 opacity-75">Все сотрудники</p>
                </div>
            </div>
            <a href="{{ path('admin_employees_create') }}" class="btn btn-primary btn-lg">
                <i class="fas fa-plus-circle me-2"></i>
                Создать сотрудника
            </a>
        </div>
    </div>
    <div class="container-fluid mb-4">
        <div class="card">
            <div class="card-header bg-light py-2">
                <h3 class="mb-0">🔍 Фильтрация и сортировка</h3>
            </div>
            <div class="card-body p-3">
                <form method=GET action="{{ path('admin_employees_index') }}" class="row g-2 align-items-end">
                    {% if app.request.get('page') %}
                        <input type="hidden" name="page" value="{{ app.request.get('page') }}">
                    {% endif %}

                    {% include '/include/search.html.twig' %}

                    {% include '/include/filter_and_sort.html.twig' with {
                        filters: filters,
                        sorts: sorts
                    } %}
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">Применить</button>
                    </div>
                    <div class="col-md-2">
                        <a href="{{ path('admin_employees_index') }}" class="btn btn-outline-secondary btn-sm w-100">
                            Сбросить
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th style="width: 5%; min-width: 10px;">ID</th>
                    <th style="width: 15%; min-width: 20px;">name</th>
                    <th style="width: 15%; min-width: 20px;">shop</th>
                    <th style="width: 15%; min-width: 20px;">surname</th>
                    <th style="width: 15%; min-width: 20px;">position</th>
                    <th style="width: 15%; min-width: 20px;">phone</th>
                    <th style="width: 15%; min-width: 20px;">Состояние</th>
                    <th style="width: 20%; min-width: 50px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for employee in employees %}
                    <tr>
                        <td><strong>#{{ employee.id }}</strong></td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ employee.name }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ employee_service.getShopName(employee) }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ employee.surname }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ employee.position }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ employee.phone }}
                            </div>
                        </td>
                        <td>
                            <div class="status-badges">
                                {% if employee.isDismissed %}
                                    <span class="status-badge inactive">
                                     <i class="fas fa-check-circle"></i>
                                        Уволен
                                    </span>
                                {% else %}
                                    <span class="status-badge active">
                                        <i class="fas fa-times-circle"></i>
                                        Работает
                                    </span>
                                {% endif %}
                                {% if employee.isDeleted %}
                                    <span class="status-badge deleted">
                                        <i class="fas fa-trash"></i>
                                        Удален
                                    </span>
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            {% if not employee.isDeleted %}
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('admin_employees_edit', { 'id': employee.id }) }}"
                                       class="btn btn-outline-primary" title="Редактировать">
                                        ✏️
                                    </a>
                                    <form method="post"
                                          action="{{ path('admin_employees_delete', { 'id': employee.id }) }}"
                                          style="display: inline;"
                                          onsubmit="return confirm('Вы уверены, что хотите удалить этого сотрудника ?')"
                                          data-turbo="false">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete' ~ employee.id) }}">
                                        <button class="btn btn-outline-danger" title="Удалить">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-users"></i>
                            <h5>Страны не найдены</h5>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if employees.getPageCount() > 1 %}
            <div class="border-top pt-3 mt-4">
                <div class="d-flex justify-content-between align-items-center pagination-container">
                    <div class="text-muted">
                        Страница: <strong>{{ employees.getCurrentPageNumber }}</strong> из
                        <strong>{{ employees.getPageCount() }}</strong>
                    </div>

                    <div>
                        {{ knp_pagination_render(
                            employees,
                            '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig',
                            {},
                            {'css_container_class': 'pagination pagination-sm mb-0'}
                        ) }}
                    </div>

                    <div class="text-muted">
                        Всего: <strong>{{ employees.getTotalItemCount }}</strong> записей
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
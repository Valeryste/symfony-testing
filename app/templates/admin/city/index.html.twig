{% extends 'admin/base.html.twig' %}

{% block title %}Управление городами{% endblock %}

{% block admin_content %}
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1">Управление городами</h1>
                    <p class="mb-0 opacity-75">Все города</p>
                </div>
            </div>
        </div>
    </div>
    <div class="position-fixed bottom-0 end-0 m-4" style="z-index: 1000;">
        <div class="card shadow-sm" style="width: 300px;">
            <div class="card-header bg-primary text-white py-2">
                <h6 class="mb-0">➕ Добавить город</h6>
            </div>
            <div class="card-body p-3">
                {{ form_start(createForm, {
                    'action': path('admin_cities_store'),
                    'attr': {
                        'class': 'country-form',
                        'data-turbo': 'false'
                    }

                }) }}
                {% if app.request.get('page') %}
                    <input type="hidden" name="page" value="{{ app.request.get('page') }}">
                {% endif %}
                <div class="mb-2">
                    {{ form_label(createForm.name, 'Название города', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.name, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите название города'
                        }
                    }) }}
                    {{ form_errors(createForm.name) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.country, 'Страна', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.country, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                        }
                    }) }}
                    {{ form_errors(createForm.country) }}
                </div>
                <button type="submit" class="btn btn-success btn-sm w-100">
                    ➕ Добавить
                </button>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>
    <div class="container-fluid mb-4">
        <div class="card">
            <div class="card-header bg-light py-2">
                <h3 class="mb-0">🔍 Фильтрация и сортировка</h3>
            </div>
            <div class="card-body p-3">
                <form method="get" action="{{ path('admin_cities_index') }}" class="row g-2 align-items-end">
                    {% if app.request.get('page') %}
                        <input type="hidden" name="page" value="{{ app.request.get('page') }}">
                    {% endif %}

                    {% include '/include/filter_and_sort.html.twig' with {
                        filters: filters,
                        sorts: sorts
                    } %}
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">Применить</button>
                    </div>
                    <div class="col-md-2">
                        <a href="{{ path('admin_cities_index') }}" class="btn btn-outline-secondary btn-sm w-100">
                            Сбросить
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th style="width: 5%; min-width: 10px;">ID</th>
                    <th style="width: 15%; min-width: 20px;">name</th>
                    <th style="width: 15%; min-width: 20px;">country</th>
                    <th style="width: 15%; min-width: 20px;">Состояние</th>
                    <th style="width: 20%; min-width: 50px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for city in cities %}
                    <tr>
                        <td><strong>#{{ city.id }}</strong></td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ city.name }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ get_country_name(city) }}
                            </div>

                        </td>
                        <td>
                            {% if city.isDeleted %}
                                <span class="status-badge inactive">
                                    <i class="fas fa-check-circle"></i>
                                        Удален
                                </span>
                            {% else %}
                                <span class="status-badge active">
                                    <i class="fas fa-check-circle"></i>
                                        Действует
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if city.isDeleted == null %}
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('admin_cities_edit', { 'id': city.id }) }}"
                                       class="btn btn-outline-primary" title="Редактировать">
                                        ✏️
                                    </a>
                                    <form method="post"
                                          action="{{ path('admin_cities_delete', { 'id': city.id }) }}"
                                          style="display: inline;"
                                          onsubmit="return confirm('Вы уверены, что хотите удалить этот город?')"
                                          data-turbo="false">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete' ~ city.id) }}">
                                        <button class="btn btn-outline-danger" title="Удалить">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-users"></i>
                            <h5>Страны не найдены</h5>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if cities.getPageCount() > 1 %}
            <div class="border-top pt-3 mt-4">
                <div class="d-flex justify-content-between align-items-center pagination-container">
                    <div class="text-muted">
                        Страница: <strong>{{ cities.getCurrentPageNumber }}</strong> из
                        <strong>{{ cities.getPageCount() }}</strong>
                    </div>

                    <div>
                        {{ knp_pagination_render(
                            cities,
                            '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig',
                            {},
                            {'css_container_class': 'pagination pagination-sm mb-0'}
                        ) }}
                    </div>

                    <div class="text-muted">
                        Всего: <strong>{{ cities.getTotalItemCount }}</strong> записей
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
{% extends 'admin/base.html.twig' %}

{% block title %}Управление пользователями{% endblock %}

{% block admin_content %}
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1">Управление пользователями</h1>
                    <p class="mb-0 opacity-75">Все пользователи системы</p>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid mb-4">
        <div class="card">
            <div class="card-header bg-light py-2">
                <h3 class="mb-0">🔍 Фильтрация и сортировка</h3>
            </div>
            <div class="card-body p-3">
                <form method="get" action="{{ path('admin_users_index') }}" class="row g-2 align-items-end">
                    {% if app.request.get('page') %}
                        <input type="hidden" name="page" value="{{ app.request.get('page') }}">
                    {% endif %}

                    <div class="row">
                        {% for filter in filters %}
                            <div class="col-md-3 mb-3">
                                {% if filter.getType == 'checkbox' %}
                                    <div class="form-check">
                                        <input type="checkbox"
                                               name="filters[{{ filter.value }}]"
                                               id="filter_{{ filter.value }}"
                                               class="form-check-input filter-checkbox"
                                               value="{{ (app.request.query.all()['filters'][filter.value] ?? '') == '1' ? '1' : '0' }}"
                                                {{ (app.request.query.all()['filters'][filter.value] ?? '') == '1' ? 'checked' : '' }}
                                               onchange="this.value = this.checked ? '1' : '0'">
                                        <label class="form-check-label fw-bold" for="filter_{{ filter.value }}">
                                            {{ filter.translateValueToRu }}
                                        </label>
                                    </div>

                                {% elseif filter.getType == 'select' %}
                                    {% set variableName = filter.getTemplateVariable() %}
                                    {% if attribute(_context, variableName) is defined %}
                                        {% include 'admin/filter/filterSelect.html.twig' with {
                                            filter: filter,
                                            items: attribute(_context, variableName)
                                        } %}
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endfor %}
                        {% for sort in sorts %}
                            <div class="col-md-3 mb-3">
                                <div class="sort-item">
                                    <label class="form-label fw-bold mb-2">Сортировка {{ sort.translateValueToRu }}</label>
                                    <label>
                                        <select name="sorts[{{ sort.value }}]" class="form-select form-select-sm sort-select">
                                            <option value="">Не сортировать</option>
                                            {% for direction in sort.getDirection %}
                                                <option value="{{ direction }}"
                                                        {% if app.request.query.all['sorts'][sort.value] is defined
                                                            and app.request.query.all['sorts'][sort.value] == direction %}selected{% endif %}>
                                                    {{ sort.getDirectionToRu[loop.index0] }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </label>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">Применить</button>
                    </div>
                    <div class="col-md-2">
                        <a href="{{ path('admin_users_index') }}" class="btn btn-outline-secondary btn-sm w-100">
                            Сбросить
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th style="width: 5%; min-width: 60px;">ID</th>
                    <th style="width: 15%; min-width: 120px;">Username</th>
                    <th style="width: 25%; min-width: 200px;">Email</th>
                    <th style="width: 15%; min-width: 120px;">Роль</th>
                    <th style="width: 10%; min-width: 100px;">Статус</th>
                    <th style="width: 20%; min-width: 150px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td><strong>#{{ user.id }}</strong></td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ user.username }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-envelope text-muted me-2"></i>
                                {{ user.email }}
                            </div>
                        </td>
                        <td>
                            <span>{{ user.role.name }}</span>
                        </td>
                        <td>
                            <div class="status-badges">
                                {% if user.isActive %}
                                    <span class="status-badge active">
                                     <i class="fas fa-check-circle"></i>
                                        Активен
                                    </span>
                                {% else %}
                                    <span class="status-badge inactive">
                                        <i class="fas fa-times-circle"></i>
                                        Неактивен
                                    </span>
                                {% endif %}

                                {% if user.isDeleted %}
                                    <span class="status-badge deleted">
                                        <i class="fas fa-trash"></i>
                                        Удален
                                    </span>
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            {% if user.isDeleted == null %}
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('admin_users_edit', { 'id': user.id }) }}"
                                       class="btn btn-outline-primary" title="Редактировать">
                                        ✏️
                                    </a>
                                    <form method="post" action="{{ path('admin_users_delete', { 'id': user.id }) }}"
                                          style="display: inline;"
                                          onsubmit="return confirm('Вы уверены, что хотите удалить этого пользователя?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button class="btn btn-outline-danger" title="Удалить">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-users"></i>
                            <h5>Пользователи не найдены</h5>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if users.getPageCount() > 1 %}
            <div class="border-top pt-3 mt-4">
                <div class="d-flex justify-content-between align-items-center pagination-container">
                    <div class="text-muted">
                        Страница: <strong>{{ users.getCurrentPageNumber }}</strong> из
                        <strong>{{ users.getPageCount() }}</strong>
                    </div>

                    <div>
                        {{ knp_pagination_render(
                            users,
                            '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig',
                            {},
                            {'css_container_class': 'pagination pagination-sm mb-0'}
                        ) }}
                    </div>

                    <div class="text-muted">
                        Всего: <strong>{{ users.getTotalItemCount }}</strong> записей
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
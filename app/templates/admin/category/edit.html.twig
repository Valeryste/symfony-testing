{% extends 'admin/base.html.twig' %}

{% block title %}Редактирование категории #{{ category.id }} - Admin Panel{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
            <h1 class="h2">Редактирование категории</h1>
            <div>
                <a href="{{ path('admin_categories_index') }}" class="btn">
                    ← Назад к списку
                </a>
            </div>
        </div>
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="row">
            <div class="col-md-8">
                {{ form_start(updateForm, {
                    'action': path('admin_categories_update', { 'id': category.id }),
                    'method': 'POST'
                }) }}
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Основная информация</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label text-muted">ID категории</label>
                            <div class="form-control-plaintext">#{{ category.id }}</div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(updateForm.name, 'name', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(updateForm.name, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(updateForm.name) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(updateForm.parent, 'parent', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(updateForm.parent, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(updateForm.parent) }}
                        </div>
                        <div class="mb-3">
                            {{ form_widget(updateForm.isActive, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_label(updateForm.isActive, 'активная категория', {'label_attr': {'class': 'form-check-label'}}) }}
                            {{ form_errors(updateForm.isActive) }}
                        </div>
                    </div>
                </div>
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                💾 Сохранить изменения
                            </button>
                            <a href="{{ path('admin_categories_edit', { 'id': category.id }) }}"
                               class="btn btn-outline-secondary">
                                🔄 Сбросить
                            </a>
                        </div>
                    </div>
                </div>
                {{ form_end(updateForm) }}
            </div>
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex gap-2">
                        <form method="post" action="{{ path('admin_categories_delete', { 'id': category.id }) }}"
                              style="display: inline;"
                              onsubmit="return confirm('Вы уверены, что хотите удалить категорию?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                            <button class="btn btn-outline-danger" title="Удалить">
                                🗑️ Удалить
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="table-responsive">
            <h2>Продукты категории</h2>
            <table class="table table-striped">
                <thead>
                <tr>
                    <th style="width: 5%; min-width: 10px;">ID</th>
                    <th style="width: 15%; min-width: 20px;">name</th>
                    <th style="width: 15%; min-width: 20px;">сount</th>
                    <th style="width: 15%; min-width: 20px;">price</th>
                    <th style="width: 15%; min-width: 20px;">статус</th>
                    <th style="width: 20%; min-width: 50px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for product in category.products %}
                    <tr>
                        <td><strong>#{{ product.id }}</strong></td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ product.name }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ product.count }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ product.price }}
                            </div>
                        </td>
                        <td>
                            {% if product.isDeleted %}
                                <span class="status-badge inactive">
                                    <i class="fas fa-check-circle"></i>
                                        Удален
                                </span>
                            {% else %}
                                <span class="status-badge active">
                                    <i class="fas fa-check-circle"></i>
                                        Действует
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if product.isDeleted == null %}
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('admin_products_edit', { 'id': product.id }) }}"
                                       class="btn btn-outline-primary" title="Редактировать">
                                        ✏️
                                    </a>
                                    <form method="post"
                                          action="{{ path('admin_products_delete', { 'id': product.id }) }}"
                                          style="display: inline;"
                                          onsubmit="return confirm('Вы уверены, что хотите удалить этот продукт?')"
                                          data-turbo="false">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete' ~ product.id) }}">
                                        <button class="btn btn-outline-danger" title="Удалить">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-users"></i>
                            <h5>Города не найдены</h5>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Дополнительная информация</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Дата создания:</strong><br>
                    <span class="text-muted">{{ category.createdAt ? category.createdAt|date('d.m.Y H:i') : 'Не указана' }}</span>
                </div>

                <div class="mb-3">
                    <strong>Последнее обновление данных:</strong><br>
                    <span class="text-muted">{{ category.updatedAt ? category.updatedAt|date('d.m.Y H:i') : 'Не указана' }}</span>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% extends 'admin/base.html.twig' %}

{% block title %}Управление категориями{% endblock %}

{% import "admin/macros/category_tree.html.twig" as category_tree %}

{% block admin_content %}
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1">Управление категориями</h1>
                    <p class="mb-0 opacity-75">Все категории</p>
                </div>
            </div>
        </div>
        <a href="{{ path('admin_categories_create') }}" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle me-2"></i>
            Создать категорию
        </a>
    </div>

    <div class="container-fluid mb-4">
        <div class="card">
            <div class="card-header bg-light py-2">
                <h3 class="mb-0">🔍 Фильтрация и сортировка</h3>
            </div>
            <div class="card-body p-3">
                <form method="GET" action="{{ path('admin_categories_index') }}" class="row g-2 align-items-end">
                    {% if app.request.get('page') %}
                        <input type="hidden" name="page" value="{{ app.request.get('page') }}">
                    {% endif %}

                    {% include '/include/search.html.twig' %}

                    {% include '/include/filter_and_sort.html.twig' with {
                        filters: filters,
                        sorts: sorts
                    } %}
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">Применить</button>
                    </div>
                    <div class="col-md-2">
                        <a href="{{ path('admin_categories_index') }}" class="btn btn-outline-secondary btn-sm w-100">
                            Сбросить
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th style="width: 1%; min-width: 10px;">ID</th>
                    <th style="width: 5%; min-width: 20px;">name</th>
                    <th style="width: 5%; min-width: 20px;">Статус</th>
                    <th style="width: 10%; min-width: 50px;">Действия</th>
                </tr>
                </thead>
                <tbody id="categories-tree">

                {% if categories is defined and categories|length > 0 %}
                    {{ category_tree.render(categories) }}
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-users"></i>
                            <h5>Категории не найдены</h5>
                        </td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>
        {% if categories.getPageCount() > 1 %}
            <div class="border-top pt-3 mt-4">
                <div class="d-flex justify-content-between align-items-center pagination-container">
                    <div class="text-muted">
                        Страница: <strong>{{ categories.getCurrentPageNumber }}</strong> из
                        <strong>{{ categories.getPageCount() }}</strong>
                    </div>

                    <div>
                        {{ knp_pagination_render(
                            categories,
                            '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig',
                            {},
                            {'css_container_class': 'pagination pagination-sm mb-0'}
                        ) }}
                    </div>

                    <div class="text-muted">
                        Всего: <strong>{{ categories.getTotalItemCount }}</strong> записей
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
{% extends 'admin/base.html.twig' %}

{% block title %}Создание категории{% endblock %}

{% block admin_content %}
    <div class="position-fixed bottom-0 end-0 m-4" style="z-index: 1000;">
        <div class="card shadow-sm" style="width: 300px;">
            <div class="card-body p-3">
                {{ form_start(createForm, {
                    'action': path('admin_categories_store'),
                    'attr': {
                        'class': 'country-form',
                        'data-turbo': 'false'
                    }

                }) }}
                <div class="mb-2">
                    {{ form_label(createForm.name, 'Название категории', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.name, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите название'
                        }
                    }) }}
                    {{ form_errors(createForm.name) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.parent, 'Родительская категория', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.parent, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                        }
                    }) }}
                    {{ form_errors(createForm.parent) }}
                </div>
                <button type="submit" class="btn btn-success btn-sm w-100">
                    ➕ Создать
                </button>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>

{% endblock %}
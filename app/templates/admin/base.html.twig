{% extends 'base.html.twig' %}

{% block body %}
    <div class="admin-layout">
        <nav class="admin-sidebar">
            <div class="sidebar-header">
                <h2 class="admin-title">
                    <i class="fas fa-cogs"></i>
                    Админ-панель
                </h2>
            </div>

            <ul class="sidebar-menu">
                <li class="menu-item {% if app.request.attributes.get('_route') starts with 'admin_users' %}active{% endif %}">
                    <a href="{{ path('admin_users_index') }}" class="menu-link">
                    <span class="menu-icon">
                        <i class="fas fa-users"></i>
                    </span>
                        <span class="menu-text">Пользователи</span>
                    </a>
                </li>

                <li class="menu-item {% if app.request.attributes.get('_route') starts with 'admin_countries' %}active{% endif %}">
                    <a href="{{ path('admin_countries_index') }}" class="menu-link">
                    <span class="menu-icon">
                        <i class="fas fa-globe-americas"></i>
                    </span>
                        <span class="menu-text">Страны</span>
                    </a>
                </li>

                <li class="menu-item {% if app.request.attributes.get('_route') starts with 'admin_cities' %}active{% endif %}">
                    <a href="{{ path('admin_cities_index') }}" class="menu-link">
                    <span class="menu-icon">
                        <i class="fas fa-city"></i>
                    </span>
                        <span class="menu-text">Города</span>
                    </a>
                </li>
            </ul>
        </nav>

        <main class="admin-content">
            {% block admin_content %}{% endblock %}
        </main>
    </div>
{% endblock %}
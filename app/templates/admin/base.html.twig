{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 d-md-block bg-dark sidebar collapse">
                <div class="position-sticky pt-3">
                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-white">
                        <span>Админ-панель</span>
                    </h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'admin_users' %}active bg-primary{% endif %}"
                               href="{{ path('admin_users_index') }}">
                                <i class="fas fa-users me-2"></i>
                                Пользователи
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'admin_countries' %}active bg-primary{% endif %}"
                               href="{{ path('admin_countries_index') }}">
                                <i class="fas fa-globe me-2"></i>
                                Страны
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'admin_cities' %}active bg-primary{% endif %}"
                               href="{{ path('admin_cities_index') }}">
                                <i class="fas fa-city me-2"></i>
                                Города
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-md-9 col-lg-10 ml-sm-auto px-4 py-4">
                {% block admin_content %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
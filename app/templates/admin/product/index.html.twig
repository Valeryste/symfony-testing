{% extends 'admin/base.html.twig' %}

{% block title %}Управление продуктами{% endblock %}

{% block admin_content %}
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1">Управление продуктами</h1>
                    <p class="mb-0 opacity-75">Все продукты</p>
                </div>
            </div>
        </div>
        <a href="{{ path('admin_products_create') }}" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle me-2"></i>
            Создать продукт
        </a>
    </div>

    <div class="container-fluid mb-4">
        <div class="card">
            <div class="card-header bg-light py-2">
                <h3 class="mb-0">🔍 Фильтрация и сортировка</h3>
            </div>
            <div class="card-body p-3">
                <form method="GET" action="{{ path('admin_products_index') }}" class="row g-2 align-items-end">
                    {% if app.request.get('page') %}
                        <input type="hidden" name="page" value="{{ app.request.get('page') }}">
                    {% endif %}

                    {% include '/include/filter_and_sort.html.twig' with {
                        filters: filters,
                        sorts: sorts
                    } %}

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">Применить</button>
                    </div>
                    <div class="col-md-2">
                        <a href="{{ path('admin_products_index') }}" class="btn btn-outline-secondary btn-sm w-100">
                            Сбросить
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th style="width: 5%; min-width: 10px;">ID</th>
                    <th style="width: 15%; min-width: 20px;">name</th>
                    <th style="width: 15%; min-width: 20px;">сount</th>
                    <th style="width: 15%; min-width: 20px;">price</th>
                    <th style="width: 15%; min-width: 20px;">categories</th>
                    <th style="width: 15%; min-width: 20px;">статус</th>
                    <th style="width: 20%; min-width: 50px;">Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for product in products %}
                    <tr>
                        <td><strong>#{{ product.id }}</strong></td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ product.name }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ product.count }}
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-user text-muted me-2"></i>
                                {{ product.price }}
                            </div>
                        </td>
                        <td>
                            <div class="categories-badges">
                                {% for category in product.categories %}
                                    <div class="category-badge">
                                        <div class="badge-icon">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <span class="badge-text">{{ category.name }}</span>
                                    </div>
                                {% else %}
                                    <div class="empty-badge">
                                        <i class="fas fa-times-circle"></i>
                                        No categories
                                    </div>
                                {% endfor %}
                            </div>
                        </td>
                        <td>
                            <div class="status-badges">
                                {% if product.isActive %}
                                    <span class="status-badge active">
                                     <i class="fas fa-check-circle"></i>
                                        Активен
                                    </span>
                                {% else %}
                                    <span class="status-badge inactive">
                                        <i class="fas fa-times-circle"></i>
                                        Неактивен
                                    </span>
                                {% endif %}

                                {% if product.isDeleted %}
                                    <span class="status-badge deleted">
                                        <i class="fas fa-trash"></i>
                                        Удален
                                    </span>
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            {% if product.isDeleted == null %}
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('admin_products_edit', { 'id': product.id }) }}"
                                       class="btn btn-outline-primary" title="Редактировать">
                                        ✏️
                                    </a>
                                    <form method="post"
                                          action="{{ path('admin_products_delete', { 'id': product.id }) }}"
                                          style="display: inline;"
                                          onsubmit="return confirm('Вы уверены, что хотите удалить этот продукт?')"
                                          data-turbo="false">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete' ~ product.id) }}">
                                        <button class="btn btn-outline-danger" title="Удалить">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-users"></i>
                            <h5>Города не найдены</h5>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if products.getPageCount() > 1 %}
            <div class="border-top pt-3 mt-4">
                <div class="d-flex justify-content-between align-items-center pagination-container">
                    <div class="text-muted">
                        Страница: <strong>{{ products.getCurrentPageNumber }}</strong> из
                        <strong>{{ products.getPageCount() }}</strong>
                    </div>

                    <div>
                        {{ knp_pagination_render(
                            products,
                            '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig',
                            {},
                            {'css_container_class': 'pagination pagination-sm mb-0'}
                        ) }}
                    </div>

                    <div class="text-muted">
                        Всего: <strong>{{ products.getTotalItemCount }}</strong> записей
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
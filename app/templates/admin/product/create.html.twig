{% extends 'admin/base.html.twig' %}

{% block title %}Создание продукта{% endblock %}

{% block admin_content %}
    <div class="position-fixed bottom-0 end-0 m-4" style="z-index: 1000;">
        <div class="card shadow-sm" style="width: 300px;">
            <div class="card-body p-3">
                {{ form_start(createForm, {
                    'action': path('admin_products_store'),
                    'attr': {
                        'class': 'country-form',
                        'data-turbo': 'false'
                    }

                }) }}
                <div class="mb-2">
                    {{ form_label(createForm.name, 'Название продукта', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.name, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите название'
                        }
                    }) }}
                    {{ form_errors(createForm.name) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.count, 'Количество продукта', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.count, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите количество'
                        }
                    }) }}
                    {{ form_errors(createForm.count) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.price, 'Цена продукта', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.price, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                            'placeholder': 'Введите продукта'
                        }
                    }) }}
                    {{ form_errors(createForm.price) }}
                </div>
                <div class="mb-2">
                    {{ form_label(createForm.categories, 'Категории', {
                        'label_attr': {'class': 'form-label small mb-1'}
                    }) }}
                    {{ form_widget(createForm.categories, {
                        'attr': {
                            'class': 'form-control form-control-sm',
                        }
                    }) }}
                    {{ form_errors(createForm.categories) }}
                </div>
                <button type="submit" class="btn btn-success btn-sm w-100">
                    ➕ Создать
                </button>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>

{% endblock %}
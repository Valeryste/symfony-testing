<div class="row">
    {% for filter in filters %}
        <div class="col-md-3 mb-3">
            {% if filter.getInputType == 'checkbox' %}
                <div class="form-check">
                    <input type="checkbox"
                           name="filters[{{ filter.value }}]"
                           id="filter_{{ filter.value }}"
                           class="form-check-input filter-checkbox"
                           value="{{ (app.request.query.all()['filters'][filter.value] ?? '') == '1' ? '1' : '0' }}"
                            {{ (app.request.query.all()['filters'][filter.value] ?? '') == '1' ? 'checked' : '' }}
                           onchange="this.value = this.checked ? '1' : '0'">
                    <label class="form-check-label fw-bold" for="filter_{{ filter.value }}">
                        {{ filter.getDisplayName }}
                    </label>
                </div>

            {% elseif filter.getInputType == 'select' %}
                {% set variableName = filter.getTemplateVariableName %}
                {% if attribute(_context, variableName) is defined %}
                    {% set isMultiple = false %}

                    {% set isMultiple = filter.getEntityFieldType == 'array' %}

                    {% include '/include/filter_select.html.twig' with {
                        filter: filter,
                        items: attribute(_context, variableName),
                        isMultiple: isMultiple
                    } %}
                {% endif %}
            {% endif %}
        </div>
    {% endfor %}
    {% for sort in sorts %}
        <div class="col-md-3 mb-3">
            <div class="sort-item">
                <label class="form-label fw-bold mb-2">Сортировка {{ sort.translateValueToRu }}</label>
                <label>
                    <select name="sorts[{{ sort.value }}]" class="form-select form-select-sm sort-select">
                        <option value="">Не сортировать</option>
                        {% for direction in sort.getDirection %}
                            <option value="{{ direction }}"
                                    {% if app.request.query.all['sorts'][sort.value] is defined
                                        and app.request.query.all['sorts'][sort.value] == direction %}selected{% endif %}>
                                {{ sort.getDirectionToRu[loop.index0] }}
                            </option>
                        {% endfor %}
                    </select>
                </label>
            </div>
        </div>
    {% endfor %}
</div>